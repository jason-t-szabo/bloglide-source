---
import { getCollection, render } from 'astro:content';
import { href } from '../../lib/paths';
import { slugifyTopic } from '../../lib/topics';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post: any) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const topics = post.data.topics
  .map((topic: string) => ({ display: topic, slug: slugifyTopic(topic) }))
  .filter((t: any) => t.slug);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{post.data.title}</title>
  </head>
  <body class="mx-auto max-w-2xl p-8 font-sans">
    <h1 class="text-3xl font-bold mb-4">{post.data.title}</h1>
    <article class="prose">
      <Content />
    </article>
    <ul>
      {topics.map((topic: any) => (
        <li>
            <a
                class="inline-block rounded bg-gray-100 px-3 py-1 text-sm hover:bg-gray-200"
                href={href(`topics/${topic.slug}/`)}
            >
                {topic.display}
            </a>
        </li>
      ))}
    </ul>
  </body>
</html>
