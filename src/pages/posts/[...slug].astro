---
import { getCollection, render } from 'astro:content';
import { href } from '../../lib/paths';
import { slugifyTopic } from '../../lib/topics';
import { Image } from 'astro:assets';
import { warn } from '../../lib/warn';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post: any) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const topics = post.data.topics
  .map((topic: string) => ({ display: topic, slug: slugifyTopic(topic) }))
  .filter((t: any) => t.slug);

const heroes = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/blog/**/*.{png,jpg,jpeg,gif,webp,svg}'
);
const heroKey = post.data.heroImage?.replace(/^\.?\//, '');
const heroLoader = heroKey
  ? heroes[`/src/content/blog/${heroKey}`]
  : undefined;
const hero = heroLoader ? (await heroLoader()).default : null;

if (post.data.heroImage && !heroLoader) {
  warn(`heroImage not found: ${post.data.heroImage} (in ${post.id})`);
}
---
<Base title={post.data.title}>
  <h1 class="text-3xl font-bold mb-4">{post.data.title}</h1>
  {hero && <Image src={hero} alt="" class="mb-6 rounded" />}
  <article class="prose">
    <Content />
  </article>
  <ul>
    {topics.map((topic: any) => (
      <li>
          <a
              class="inline-block rounded bg-gray-100 px-3 py-1 text-sm hover:bg-gray-200"
              href={href(`topics/${topic.slug}/`)}
          >
              {topic.display}
          </a>
      </li>
    ))}
  </ul>
</Base>
