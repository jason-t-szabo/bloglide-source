---
import { getCollection, render } from 'astro:content';
import { href } from '../../lib/paths';
import { slugifyTag } from '../../lib/tags';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post: any) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const tags = post.data.tags.map((tag: string) => ({ display: tag, slug: slugifyTag(tag)}))
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{post.data.title}</title>
  </head>
  <body class="mx-auto max-w-2xl p-8 font-sans">
    <h1 class="text-3xl font-bold mb-4">{post.data.title}</h1>
    <article class="prose">
      <Content />
    </article>
    {tags.map((tag) => (
      <li>
          <a
              class="inline-block rounded bg-gray-100 px-3 py-1 text-sm hover:bg-gray-200"
              href={href(`tags/${tag.slug}/`)}
          >
              {tag.display}
          </a>
      </li>
    ))}
  </body>
</html>
