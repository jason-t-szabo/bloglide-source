---
import { getCollection, render } from 'astro:content';
import { href } from '../../lib/paths';
import { slugifyTopic } from '../../lib/topics';
import { Image } from 'astro:assets';
import { warn } from '../../lib/warn';
import Base from '../../layouts/Base.astro';
import { formatInTimeZone } from 'date-fns-tz';
import { bloglide } from '../../lib/config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post: any) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const topics = post.data.topics
  .map((topic: string) => ({ display: topic, slug: slugifyTopic(topic) }))
  .filter((t: any) => t.slug);

const heroes = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/blog/**/*.{png,jpg,jpeg,gif,webp,svg}'
);
const heroKey = post.data.heroImage?.replace(/^\.?\//, '');
const heroLoader = heroKey
  ? heroes[`/src/content/blog/${heroKey}`]
  : undefined;
const hero = heroLoader ? (await heroLoader()).default : null;

if (post.data.heroImage && !heroLoader) {
  warn(`heroImage not found: ${post.data.heroImage} (in ${post.id})`);
}

const displayZone = bloglide.site.displayTimezone ?? bloglide.site.timezone;
const pubDate = post.data.pubDate && formatInTimeZone(post.data.pubDate, displayZone, "MMMM d, yyyy 'at' h:mm a zzz");
const updatedDate = post.data.updatedDate && formatInTimeZone(post.data.updatedDate, displayZone, "MMMM d, yyyy 'at' h:mm a zzz")
---
<Base title={post.data.title}>
  <h1 class="text-3xl font-bold mb-4">{post.data.title}</h1>
  {pubDate && (<p class="text-gray-500">
    Published: <a href={href(`posts/${post.id}/`)} class="underline">
      <time class="local-time" datetime={post.data.pubDate.toISOString()}>{pubDate}</time>
    </a>
  </p>)}
  {updatedDate && (
    <p class="text-gray-500">
      Updated: <a href={href(`posts/${post.id}/`)} class="underline">
        <time class="local-time" datetime={post.data.updatedDate.toISOString()}>{updatedDate}</time>        
      </a>
    </p>
  )}
  <script is:inline>
    (function () {
      var siteZone = document.documentElement.dataset.tz;
      var readerZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (siteZone === readerZone) return;

      var els = document.querySelectorAll('time.local-time:not([data-localized])');
      for (var i = 0; i < els.length; i++) {
        var el = els[i];
        el.textContent = new Intl.DateTimeFormat(undefined, {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          hour: 'numeric',
          minute: '2-digit',
          timeZoneName: 'short',
        }).format(new Date(el.getAttribute('datetime')));
        el.setAttribute('data-localized', '');
      }
    })();
  </script>
  {hero && <Image src={hero} alt="" class="mb-6 rounded" />}
  <article class="prose max-w-none">
    <Content />
  </article>
  <ul>
    {topics.map((topic: any) => (
      <li>
          <a
              class="inline-block rounded bg-gray-100 px-3 py-1 text-sm hover:bg-gray-200"
              href={href(`topics/${topic.slug}/`)}
          >
              {topic.display}
          </a>
      </li>
    ))}
  </ul>
</Base>
