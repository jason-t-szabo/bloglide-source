---
import { getSortedTags } from '../../lib/tags';
import { href } from '../../lib/paths';

const tags = await getSortedTags();
---
<html lang="en">
  <head><meta charset="utf-8" /><title>Tags</title></head>
  <body class="mx-auto max-w-2xl p-8 font-sans">
    <h1 class="text-3xl font-bold mb-6">Tags</h1>
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li>
            <a
                class="inline-block rounded bg-gray-100 px-3 py-1 text-sm hover:bg-gray-200"
                href={href(`tags/${tag.slug}/`)}
            >
                {tag.display}
                <span class="text-gray-500">({tag.posts.length})</span>
            </a>
        </li>
      ))}
    </ul>
  </body>
</html>
