---
import { getTagRegistry, type TagInfo } from '../../lib/tags';
import { href } from '../../lib/paths';

export async function getStaticPaths() {
  const registry = await getTagRegistry();
  return [...registry.values()].map((info) => ({
    params: { tag: info.slug },
    props: { info },
  }));
}

const { info } = Astro.props as { info: TagInfo };
---
<html lang="en">
  <head><meta charset="utf-8" /><title>{info.display}</title></head>
  <body class="mx-auto max-w-2xl p-8 font-sans">
    <p class="text-sm"><a class="text-blue-600 underline" href={href('tags/')}>All tags</a></p>
    <h1 class="text-3xl font-bold mb-6">Tagged “{info.display}”</h1>
    <ul class="space-y-3">
      {info.posts.map((post) => (
        <li>
          <a class="text-blue-600 underline" href={href(`posts/${post.id}/`)}>
            {post.data.title}
          </a>
        </li>
      ))}
    </ul>
  </body>
</html>
