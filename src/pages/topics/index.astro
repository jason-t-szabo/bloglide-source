---
import { getSortedTopics } from '../../lib/topics';
import { href } from '../../lib/paths';

const topics = await getSortedTopics();
---
<html lang="en">
  <head><meta charset="utf-8" /><title>Topics</title></head>
  <body class="mx-auto max-w-2xl p-8 font-sans">
    <h1 class="text-3xl font-bold mb-6">Topics</h1>
    <ul class="flex flex-wrap gap-2">
      {topics.map((topic) => (
        <li>
            <a
                class="inline-block rounded bg-gray-100 px-3 py-1 text-sm hover:bg-gray-200"
                href={href(`topics/${topic.slug}/`)}
            >
                {topic.display}
                <span class="text-gray-500">({topic.posts.length})</span>
            </a>
        </li>
      ))}
    </ul>
  </body>
</html>
