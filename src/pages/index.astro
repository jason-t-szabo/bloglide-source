---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Bloglide</title>
  </head>
  <body class="mx-auto max-w-2xl p-8 font-sans">
    <h1 class="text-3xl font-bold mb-6">Posts</h1>
    <ul class="space-y-3">
      {posts.map((post: any) => (
        <li>
          <a class="text-blue-600 underline" href={`${base}posts/${post.id}/`}>
            {post.data.title}
          </a>
          <span class="text-sm text-gray-500 ml-2">{post.data.visibility}</span>
        </li>
      ))}
    </ul>
  </body>
</html>
