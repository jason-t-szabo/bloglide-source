---
// src/layouts/Base.astro
import { bloglide } from '../lib/config';
import { href } from '../lib/paths';
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
const displayZone = bloglide.site.displayTimezone ?? bloglide.site.timezone;
---
<!doctype html>
<html lang={bloglide.site.language} data-tz={displayZone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {bloglide.features.rss && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={bloglide.site.title}
        href={href('rss.xml')}
      />
    )}
  </head>
  <body class="mx-auto max-w-2xl p-8 font-sans">
    <Header />
    <slot />
    <script is:inline>
      (function () {
        var siteZone = document.documentElement.dataset.tz;
        var readerZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        if (siteZone === readerZone) return;

        var els = document.querySelectorAll('time.local-time:not([data-localized])');
        for (var i = 0; i < els.length; i++) {
          var el = els[i];
          el.textContent = new Intl.DateTimeFormat(undefined, {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: 'numeric',
            minute: '2-digit',
            timeZoneName: 'short',
          }).format(new Date(el.getAttribute('datetime')));
          el.setAttribute('data-localized', '');
        }
      })();
    </script>
  </body>
</html>
