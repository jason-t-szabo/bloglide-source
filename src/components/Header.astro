---
// src/components/Header.astro
import { bloglide } from '../lib/config'
import { href } from '../lib/paths'

const trim = (p: string) => p.replace(/\/+$/, '')
const current = trim(Astro.url.pathname)

const isCurrent = (path: string) => {
  const target = trim(href(path))
  return path === '' ? current === target : current.startsWith(target)
}

const links = [
  { label: 'About', path: 'about' },
  ...(bloglide.features.topics ? [{ label: 'Topics', path: 'topics/' }] : []),
  ...(bloglide.features.rss ? [{ label: 'RSS', path: 'subscribe' }] : []),
]
---

<header class="mb-8 border-b border-gray-300 pb-2">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <a
      href={href('')}
      aria-current={isCurrent('') ? 'page' : undefined}
      class="px-3 py-2 rounded-sm text-xl font-semibold hover:underline focus-visible:outline-2 aria-[current=page]:bg-gray-200 aria-[current=page]:underline aria-[current=page]:decoration-dotted"
    >
      {bloglide.site.title}
    </a>

    <nav aria-label="Main">
      <ul class="flex flex-wrap gap-2 text-sm">
        {links.map((link) => (
          <li>
            <a
              href={href(link.path)}
              aria-current={isCurrent(link.path) ? 'page' : undefined}
              class="px-3 py-2 rounded-sm hover:underline focus-visible:outline-2 font-semibold aria-[current=page]:bg-gray-200 aria-[current=page]:underline aria-[current=page]:decoration-dotted"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
