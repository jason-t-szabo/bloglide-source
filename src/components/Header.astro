---
// src/components/Header.astro
import { bloglide } from '../lib/config';
import { href } from '../lib/paths';

const trim = (p: string) => p.replace(/\/+$/, '');
const current = trim(Astro.url.pathname);

const links = [
  { label: 'About', path: 'about' },
  ...(bloglide.features.topics ? [{ label: 'Topics', path: 'topics/' }] : []),
  ...(bloglide.features.rss ? [{ label: 'RSS', path: 'subscribe' }] : []),
];
---
<header class="mb-8 border-b border-gray-200 pb-2">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <div aria-current={current === bloglide.site.base ? 'page' : undefined} class="px-3 py-2 rounded-sm aria-[current=page]:bg-gray-200">
      <a
        href={href('')}
        class="text-xl font-semibold hover:underline focus-visible:outline-2 focus-visible:outline-offset-3"
      >{bloglide.site.title}</a>
    </div>

    <nav aria-label="Main">
      <ul class="flex flex-wrap gap-2 text-sm">
        {links.map((link) => (
          <li aria-current={current === trim(href(link.path)) ? 'page' : undefined} class="px-3 py-2 rounded-sm aria-[current=page]:bg-gray-200">
            <a
              href={href(link.path)}              
              class="hover:underline focus-visible:outline focus-visible:outline-offset-2 font-semibold"
            >{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
