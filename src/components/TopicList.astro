---
import { href } from '../lib/paths'
import type { TopicInfo } from '../lib/topics'
import TopicChip from './TopicChip.astro'

interface Props {
  topics: TopicInfo[]
  order: 'name' | 'popular'
}
const { topics, order } = Astro.props

const views = [
  { label: 'A–Z', value: 'name', path: 'topics/' },
  { label: 'Most posts', value: 'popular', path: 'topics/sort/popular/' },
]
---

<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-6">
  <h1 class="text-3xl font-bold">All Topics</h1>

  {topics.length > 0 && (
    <nav aria-label="Sort topics">
      <ul class="flex gap-2 text-sm">
        {views.map((view) => (
          <li>
            <a
              href={href(view.path)}
              aria-current={view.value === order ? 'page' : undefined}
              class="inline-block rounded-sm px-3 py-1 bg-gray-100 hover:bg-gray-200 focus-visible:outline-2 aria-[current=page]:bg-gray-300 aria-[current=page]:font-semibold"
            >
              {view.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</div>

{topics.length === 0 ?
  <p class="text-gray-500">No topics yet.</p>
: <ul class="flex flex-wrap gap-2">
    {topics.map((topic) => (
      <TopicChip topic={topic} />
    ))}
  </ul>
}
